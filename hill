    // Check if the length of the plaintext is odd
    if (strlen(plaintext) % 2 != 0) {
        // Append a filler letter (e.g., 'x') to make it even-length
        plaintext[strlen(plaintext)] = 'x';
        plaintext[strlen(plaintext) + 1] = '\0';
    }

    // Encrypt the plaintext
